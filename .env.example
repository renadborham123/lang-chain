# Ollama model provider (can also be changed in the UI)
MODEL_PROVIDER=ollama_local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=job-matcher

# Search defaults
DEFAULT_LOCATION=Cairo
RESULTS_PER_QUERY=10
TOP_N_JOBS=10
MEMORY_DB_PATH=./memory/job_matcher_memory.sqlite
DOCUMENT_TTL_HOURS=24
APPLICATION_SESSION_TTL_MINUTES=20
