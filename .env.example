# Ollama model provider (can also be changed in the UI)
MODEL_PROVIDER=ollama_local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=job-matcher

# Search defaults
DEFAULT_LOCATION=Cairo
RESULTS_PER_QUERY=10
TOP_N_JOBS=10
MEMORY_DB_PATH=./memory/job_matcher_memory.sqlite
# 0 keeps user-managed CVs until explicit deletion.
DOCUMENT_TTL_HOURS=0
APPLICATION_SESSION_TTL_MINUTES=20

# Employment OS persistence and local background work
JOBFLOW_DATABASE_URL=sqlite:///memory/employment.sqlite
JOBFLOW_TIMEZONE=Africa/Cairo
JOBFLOW_CALLBACK_SECRET=replace_with_a_long_random_secret
# Use production and HTTPS together when deployed publicly.
JOBFLOW_ENV=development
JOBFLOW_SECURE_COOKIES=false
JOBFLOW_FORCE_HTTPS=false
JOBFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JOBFLOW_AUTH_RATE_LIMIT=20
# Development-only one-time claim of data created before login/accounts existed.
JOBFLOW_CLAIM_LOCAL_DATA=true
PUBLIC_APP_URL=http://127.0.0.1:5173

# Transactional email (password reset). Any standard SMTP provider works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional Gmail and Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Outlook Mail and Calendar OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Local voice transcription model: tiny, base, small, medium, or large-v3
WHISPER_MODEL=base
